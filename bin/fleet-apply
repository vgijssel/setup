#!/usr/bin/env bash
# fleet-apply — discover and apply EVERY Fleet bundle in the repo.
#
# Repo-wide helper (alongside bin/help). It finds every `fleet.yaml` under apps/,
# derives each bundle's name from its path (apps/<group>/src/<component> ->
# <group>-<component>, matching the historical explicit names), and runs
# `fleet apply` for each into the fleet-local workspace. There is NO hardcoded
# bundle list: adding a component = adding a src/<x>/fleet.yaml.
#
# Cluster targeting is the ONLY deploy gate. Every bundle is applied (its Bundle
# object is created) regardless of cluster; each fleet.yaml's targetCustomizations +
# clusterSelector on cluster.vgijssel.nl/name decide whether the current cluster
# gets a BundleDeployment. So a bundle meant for another cluster (e.g. a
# network-only bundle when running on the secret cluster) is applied here but
# produces no deployment.
# Runtime ordering comes from dependsOn label selectors, not apply order.
#
# CWD is the repo root so Fleet resolves umbrella `file://` chart dependencies
# (and builds them, helm-dependency-update style) relative to it.
#
# Idempotent: `fleet apply` upserts Bundles. Safe to re-run.
#
# Usage: bin/fleet-apply [namespace]   (namespace defaults to fleet-local)
set -euo pipefail

# `pwd -P`, not `pwd`: ~/.local/setup/bin is a symlink to this repo's bin/ and is on PATH,
# so this script is often invoked through it. Logical `pwd` would then resolve REPO_ROOT to
# ~/.local/setup, where `find apps` finds nothing and the run dies on a bare exit 1 without
# applying a single bundle.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd -P)"
FLEET_NS="${1:-${FLEET_NAMESPACE:-fleet-local}}"

require() { command -v "$1" >/dev/null 2>&1 || { echo "ERROR: '$1' is required but not found" >&2; exit 1; }; }
require fleet
require find

# Resolve file:// chart deps relative to the repo root.
cd "${REPO_ROOT}"

echo "==> Discovering Fleet bundles (fleet.yaml) under apps/"

# Collect and sort for deterministic ordering (dependsOn handles real ordering).
bundles="$(find apps -type f -name fleet.yaml 2>/dev/null | sort)"

if [[ -z "${bundles}" ]]; then
  echo "WARN: no fleet.yaml found under apps/" >&2
  exit 0
fi

count=0
while IFS= read -r manifest; do
  [[ -z "${manifest}" ]] && continue
  dir="$(dirname "${manifest}")"
  # apps/<group>/src/<component> -> <group>-<component> (leftover slashes -> '-').
  name="$(printf '%s' "${dir}" | sed -E 's#^apps/##; s#/src/#-#; s#/#-#g')"
  # ── DROP ANY PREVIOUSLY-BUILT SUBCHART SO A `file://` DEP IS ALWAYS REBUILT ───────────────
  # `fleet apply` resolves umbrella dependencies ONLY when charts/ is absent. With a tgz already
  # there it ships that one verbatim, and Chart.lock's digest covers the dependency DECLARATION
  # (name/version/repository), not the dependency's CONTENT — so editing a shared chart under
  # apps/platform/src/ changes neither, and the stale tgz keeps winning. Fleet then correctly
  # reports "unchanged (bundle)" and the edit silently never deploys.
  #
  # That cost a debug cycle on 2026-10-06: a new sidecar volume in the shared mesh-service chart
  # rendered fine in `helm template`, PASSED `moon run :fleet_build`, and still did not reach the
  # cluster. bin/fleet-build already deletes charts/ before building for exactly this reason
  # (a stale tgz would hide the pin drift it exists to catch) — so the verify path was rebuilding
  # while the apply path was not, which is the worst possible split: the check that is supposed to
  # catch problems was the only one seeing the new code.
  #
  # Guarded by git check-ignore: these charts/ directories are gitignored build output. A TRACKED
  # charts/ is a vendored dependency somebody committed on purpose, so leave it alone and say so.
  if [[ -d "${dir}/charts" ]]; then
    if git check-ignore -q "${dir}/charts" 2>/dev/null; then
      rm -rf "${dir}/charts"
    else
      echo "    WARN ${dir}/charts is tracked; not rebuilding its dependencies" >&2
    fi
  fi
  echo "==> fleet apply -n ${FLEET_NS} ${name} ${dir}"
  fleet apply -n "${FLEET_NS}" "${name}" "${dir}"
  count=$((count + 1))
done <<<"${bundles}"

echo "==> Applied ${count} bundle(s) into ${FLEET_NS}."
