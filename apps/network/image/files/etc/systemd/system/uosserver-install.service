# First-boot install of UniFi OS Server (runs once per Volume; guarded by a marker).
# Ordered after the data Volume mount so /var/lib/uosserver is on the Volume before the
# installer populates the rootless Podman storage there.
[Unit]
Description=First-boot install of UniFi OS Server (official Podman installer)
After=cos-setup-boot.service network-online.target
Wants=network-online.target
RequiresMountsFor=/var/lib/uosserver
ConditionPathExists=!/var/lib/uosserver/.uos-installed

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=1200
ExecStart=/usr/bin/network-uos-install.sh

[Install]
WantedBy=multi-user.target
