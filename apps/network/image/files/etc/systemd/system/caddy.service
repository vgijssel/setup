# Caddy — Tailscale-only reverse proxy with automatic LE certs (Cloudflare DNS-01).
# Ordered after tailscaled (needs tailscale0) and the volume mount (cert/ACME state lives
# on /var/lib/data via XDG_DATA_HOME). Config/secrets come from /etc/caddy/caddy.env
# (written by cloud-config); network-caddy-run.sh binds the tailscale0 IP.
[Unit]
Description=Caddy (Tailscale-only reverse proxy, LE via Cloudflare DNS-01)
After=network-online.target tailscaled.service tailscale-up.service cos-setup-boot.service
Wants=network-online.target
RequiresMountsFor=/var/lib/data

[Service]
Type=notify
EnvironmentFile=/etc/caddy/caddy.env
Environment=XDG_DATA_HOME=/var/lib/data/caddy
ExecStartPre=/usr/bin/mkdir -p /var/lib/data/caddy
ExecStart=/usr/bin/network-caddy-run.sh
ExecReload=/usr/bin/caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile --force
Restart=on-failure
RestartSec=10
TimeoutStartSec=90
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
