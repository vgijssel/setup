{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["mergeConfidence:all-badges", "config:recommended"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "customManagers": [
    {
      "customType": "jsonata",
      "fileFormat": "yaml",
      "managerFilePatterns": ["/(^|/)moon\\.yml$/"],
      "matchStrings": [
        "$each(project.metadata.dependencies, function($v, $k) { { \"depName\": $k, \"currentValue\": $v.version, \"datasource\": $v.datasource, \"packageName\": $v.packageName } })"
      ]
    }
  ],
  "pip-compile": {
    "managerFilePatterns": ["/(^|/)requirements\\.txt$/"]
  },
  "addLabels": ["dependencies"],
  "constraints": {
    "python": "<= 3.12"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true,
    "automergeType": "pr",
    "platformAutomerge": true
  },
  "packageRules": [
    {
      "matchCategories": ["ruby"],
      "enabled": false
    },
    {
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0/",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true
    },
    {
      "description": "Dependency updates to the released OpenBao plugins must be releasable. These two directories are release-please packages whose published versions are immutable, so a change typed with the repo-global `chore` would alter the shipped image (both run on `FROM alpine`) without producing a version bump — and the registry guard in release.sh would then correctly refuse to re-push the existing tag, leaving base-image CVE fixes permanently unpublished. `fix` makes them ship. Note the automerge rule above still does not apply to these 0.x packages, so their PRs land by hand.",
      "matchFileNames": [
        "libs/openbao-netbird-plugin/**",
        "libs/openbao-cloudflare-plugin/**"
      ],
      "semanticCommitType": "fix"
    }
  ],
  "pip_requirements": {
    "managerFilePatterns": ["/(^|/)requirements\\.in$/"],
    "ignorePaths": ["**/requirements.txt"]
  },
  "bazel-module": {
    "enabled": true
  },
  "bazel": {
    "managerFilePatterns": ["/(^|/)WORKSPACE\\.bzlmod$/"]
  },
  "docker-compose": {
    "managerFilePatterns": ["/(^|/)docker-compose\\.yml\\.j2$/"]
  },
  "automergeSchedule": ["after 9am every weekday", "before 5pm every weekday"]
}
